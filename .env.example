DATABASE_URL=postgres://casework:casework@localhost:5432/casework
APP_BASE_URL=http://localhost:3000
AUTH_SESSION_COOKIE_NAME=sicwe_session
AUTH_SESSION_TTL_HOURS=12

# One-time local/bootstrap setup. Do not commit real values.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.gov
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ORGANIZATION_NAME=Example Office
# BOOTSTRAP_ORGANIZATION_SLUG=example-office

# Document storage. The local driver is for development or persistent-volume deployments.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=.data/documents
DOCUMENT_MAX_BYTES=26214400

# Durable background jobs and recurring deadline processing.
BACKGROUND_JOB_LEASE_SECONDS=60
BACKGROUND_JOB_POLL_MS=1000
BACKGROUND_JOB_BATCH_SIZE=10
BACKGROUND_DEADLINE_SWEEP_SECONDS=60
