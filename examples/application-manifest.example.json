{
  "schemaVersion": 1,
  "application": {
    "key": "example_application",
    "name": "Example Application",
    "shortName": "Example",
    "description": "Domain-neutral fixture for validating the reusable thin-application contract.",
    "branding": {
      "accentColor": "#334155",
      "homeTitle": "Example Intake",
      "homeDescription": "Submit an example value to exercise the generic engine contract."
    },
    "terminology": {
      "case": {
        "singular": "Record",
        "plural": "Records"
      },
      "submission": {
        "singular": "Submission",
        "plural": "Submissions"
      },
      "submitter": {
        "singular": "Submitter",
        "plural": "Submitters"
      },
      "review": {
        "singular": "Review",
        "plural": "Reviews"
      },
      "deadline": {
        "singular": "Deadline",
        "plural": "Deadlines"
      },
      "document": {
        "singular": "Document",
        "plural": "Documents"
      },
      "queue": {
        "singular": "Queue",
        "plural": "Queues"
      }
    }
  },
  "roles": [
    {
      "key": "example_operator",
      "name": "Example Operator",
      "description": "Neutral role used only to validate manifest-defined RBAC.",
      "permissions": [
        "case:view",
        "case:update",
        "case:close",
        "deadline:view",
        "deadline:operate",
        "document:view",
        "document:upload",
        "review:view",
        "review:file",
        "protected_data:view_metadata",
        "protected_data:request_reveal"
      ]
    }
  ],
  "documentTypes": [
    {
      "key": "example_document",
      "name": "Example Document",
      "acceptedMimeTypes": [
        "application/pdf"
      ],
      "maxBytes": 10000000
    }
  ],
  "deadlineCalendars": [
    {
      "key": "example_calendar",
      "name": "Example Calendar",
      "timeZone": "UTC",
      "weekendDays": [
        0,
        6
      ]
    }
  ],
  "teams": [
    {
      "slug": "example_team",
      "name": "Example Team"
    }
  ],
  "queues": [
    {
      "slug": "example_queue",
      "name": "Example Queue",
      "teamSlug": "example_team",
      "assignmentStrategy": "round_robin"
    }
  ],
  "communicationTemplates": [
    {
      "key": "example_notice",
      "name": "Example Notice",
      "channel": "portal",
      "subjectTemplate": "Record {{case_number}}",
      "bodyTemplate": "Record {{case_number}} is currently {{case_status}}.",
      "defaultVisibility": "participant"
    }
  ],
  "workflows": [
    {
      "slug": "example_workflow",
      "name": "Example Workflow",
      "description": "Neutral workflow used only by integration-contract tests.",
      "definition": {
        "schemaVersion": 1,
        "initialState": "state_a",
        "states": [
          {
            "key": "state_a",
            "label": "State A"
          },
          {
            "key": "state_b",
            "label": "State B"
          },
          {
            "key": "state_c",
            "label": "State C"
          },
          {
            "key": "state_d",
            "label": "State D"
          },
          {
            "key": "state_closed",
            "label": "State Closed"
          }
        ],
        "transitions": [
          {
            "key": "advance_a_to_b",
            "label": "Advance A to B",
            "from": "state_a",
            "to": "state_b",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "optional",
            "actions": [
              {
                "type": "mark_open"
              }
            ]
          },
          {
            "key": "advance_b_to_c",
            "label": "Advance B to C",
            "from": "state_b",
            "to": "state_c",
            "requiredPermissions": [
              "case:update"
            ],
            "comment": "optional",
            "actions": [
              {
                "type": "mark_resolved"
              }
            ]
          },
          {
            "key": "close_d",
            "label": "Close D",
            "from": "state_d",
            "to": "state_closed",
            "requiredPermissions": [
              "case:close"
            ],
            "comment": "optional",
            "actions": [
              {
                "type": "mark_closed"
              }
            ]
          }
        ],
        "deadlinePolicies": [
          {
            "key": "example_deadline",
            "label": "Example Deadline",
            "trigger": {
              "type": "transition",
              "transitionKey": "advance_a_to_b"
            },
            "duration": {
              "value": 2,
              "unit": "business_days"
            },
            "warningBefore": {
              "value": 1,
              "unit": "business_days"
            },
            "calendarKey": "example_calendar",
            "completeOnTransitions": [
              "advance_b_to_c"
            ]
          }
        ]
      }
    }
  ],
  "forms": [
    {
      "slug": "example_form",
      "name": "Example Form",
      "description": "Neutral public form used by the generic integration contract.",
      "accessMode": "public",
      "workflowSlug": "example_workflow",
      "definition": {
        "schemaVersion": 1,
        "intro": "Provide an example value.",
        "submitLabel": "Submit",
        "confirmationMessage": "The example submission was received.",
        "sections": [
          {
            "id": "example_section",
            "title": "Example Section",
            "fields": [
              {
                "id": "example_contact_mode",
                "type": "select",
                "label": "Example contact mode",
                "required": true,
                "options": [
                  {
                    "value": "status_only",
                    "label": "Status only"
                  },
                  {
                    "value": "messaging",
                    "label": "Messaging"
                  }
                ]
              },
              {
                "id": "example_value",
                "type": "long_text",
                "label": "Example value",
                "required": true,
                "validation": {
                  "minLength": 5,
                  "maxLength": 1000
                }
              },
              {
                "id": "example_secret",
                "type": "short_text",
                "label": "Example protected value",
                "required": true,
                "validation": {
                  "minLength": 3,
                  "maxLength": 200
                },
                "protection": {
                  "compartment": "example_secret",
                  "revealPolicy": "dual_control"
                }
              },
              {
                "id": "example_attachment",
                "type": "file",
                "label": "Example attachment",
                "required": false,
                "acceptedMimeTypes": [
                  "application/pdf"
                ],
                "maxFiles": 2,
                "publicUpload": {
                  "documentTypeKey": "example_document",
                  "visibility": "internal"
                }
              }
            ]
          }
        ],
        "participantPortal": {
          "enabled": true,
          "allowMessaging": true,
          "messagingCondition": {
            "fieldId": "example_contact_mode",
            "operator": "equals",
            "value": "messaging"
          }
        }
      }
    }
  ],
  "routingRules": [
    {
      "key": "example_route",
      "name": "Example Route",
      "priority": 100,
      "targetQueueSlug": "example_queue",
      "definition": {
        "schemaVersion": 1,
        "match": "all",
        "conditions": [
          {
            "field": "case_type",
            "operator": "equals",
            "value": "example_form"
          }
        ]
      }
    }
  ],
  "reviewPolicies": [
    {
      "key": "example_review",
      "name": "Example Review",
      "description": "Neutral independent-review policy for contract testing.",
      "level": 1,
      "eligibleCaseStatuses": [
        "state_c"
      ],
      "filingWindow": {
        "value": 10,
        "unit": "business_days"
      },
      "decisionDeadline": {
        "value": 5,
        "unit": "business_days"
      },
      "decisionWarningBefore": {
        "value": 1,
        "unit": "business_days"
      },
      "calendarKey": "example_calendar",
      "allowedOutcomes": [
        "outcome_a",
        "outcome_b"
      ],
      "requireIndependentReviewer": true,
      "prerequisitePolicyKeys": []
    }
  ],
  "referralPolicies": [
    {
      "key": "example_external_referral",
      "name": "Example External Referral",
      "description": "Neutral policy used to validate parallel referral tracking.",
      "definition": {
        "schemaVersion": 1,
        "deadlinePolicies": [
          {
            "key": "example_acknowledgment",
            "label": "Example acknowledgment",
            "trigger": "sent",
            "duration": {
              "value": 2,
              "unit": "business_days"
            },
            "warningBefore": {
              "value": 1,
              "unit": "business_days"
            },
            "calendarKey": "example_calendar",
            "completeOnEvents": [
              "acknowledged",
              "preliminary_response",
              "status_update",
              "final_response",
              "completed",
              "cancelled"
            ],
            "escalation": {
              "priority": "high",
              "queueSlug": "example_queue"
            }
          },
          {
            "key": "example_final_response",
            "label": "Example final response",
            "trigger": "sent",
            "duration": {
              "value": 10,
              "unit": "calendar_days"
            },
            "warningBefore": {
              "value": 2,
              "unit": "calendar_days"
            },
            "pausable": true,
            "completeOnEvents": [
              "final_response",
              "completed",
              "cancelled"
            ],
            "escalation": {
              "priority": "high",
              "queueSlug": "example_queue"
            }
          }
        ]
      }
    }
  ],
  "operationalViews": [
    {
      "key": "example_open_work",
      "name": "Example Open Work",
      "description": "Neutral application-defined operational view.",
      "definition": {
        "statuses": [],
        "priorities": [],
        "queueSlugs": [
          "example_queue"
        ],
        "tags": [],
        "focus": "open",
        "sort": "priority_desc",
        "limit": 50
      }
    }
  ],
  "operationalMetrics": [
    {
      "key": "example_open_work_count",
      "name": "Example Open Work Count",
      "type": "case_count",
      "viewKey": "example_open_work"
    },
    {
      "key": "example_deadline_compliance",
      "name": "Example Deadline Compliance",
      "type": "deadline_compliance",
      "policyKeys": [
        "example_deadline"
      ],
      "deadlineScope": "case",
      "windowDays": 365
    },
    {
      "key": "example_referral_compliance",
      "name": "Example Referral Compliance",
      "type": "deadline_compliance",
      "policyKeys": [
        "example_acknowledgment",
        "example_final_response"
      ],
      "deadlineScope": "referral",
      "windowDays": 365
    }
  ]
}
