DATABASE_URL=postgres://casework:casework@localhost:5432/casework
APP_BASE_URL=http://localhost:3000
AUTH_SESSION_COOKIE_NAME=sicwe_session
AUTH_SESSION_TTL_HOURS=12

# External participant portal sessions.
PARTICIPANT_SESSION_COOKIE_NAME=sicwe_participant_session
PARTICIPANT_SESSION_TTL_HOURS=8
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For/X-Real-IP.
AUTH_TRUST_PROXY_HEADERS=false

# One-time local/bootstrap setup. Do not commit real values.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.gov
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ORGANIZATION_NAME=Example Office
# BOOTSTRAP_ORGANIZATION_SLUG=example-office

# Document storage. The local driver is for development or persistent-volume deployments.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=.data/documents
DOCUMENT_MAX_BYTES=26214400
# Aggregate byte ceiling for all public attachments in one form submission.
# Keep below the framework's 64 MB multipart transport ceiling.
PUBLIC_UPLOAD_TOTAL_MAX_BYTES=52428800

# Durable background jobs and recurring deadline processing.
BACKGROUND_JOB_LEASE_SECONDS=60
BACKGROUND_JOB_POLL_MS=1000
BACKGROUND_JOB_BATCH_SIZE=10
BACKGROUND_DEADLINE_SWEEP_SECONDS=60

# Integration API / webhook delivery
API_DEFAULT_RATE_LIMIT_PER_MINUTE=120
# 32-byte AES key encoded as 64 hexadecimal characters; required to create/deliver webhooks.
# WEBHOOK_ENCRYPTION_KEY=

# Protected form compartments.
# 32-byte AES key encoded as 64 hexadecimal characters.
# Required only when a published form actually uses field.protection.
# Keep this value stable for the lifetime of encrypted records; use a secrets manager.
# PROTECTED_DATA_ENCRYPTION_KEY=
